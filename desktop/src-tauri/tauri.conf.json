{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GhostNet Suite",
  "identifier": "org.ghostnet.desktop",
  "build": {
    "devUrl": "http://localhost:5273",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/sidecar.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GhostNet Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "GhostNet Suite contributors",
    "category": "Utility",
    "shortDescription": "Privacy protection and digital footprint reduction platform",
    "longDescription": "Open-source integrated desktop suite designed to protect network communications, standardize fingerprints, isolate sessions, and audit digital exposure.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/fury-agent"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
